# Merge configuration into existing server environment; never overwrite existing secrets.
# Activate only after staging verification and application of all reviewed platform migrations.
OCEANCORE_PLATFORM_ENABLED=false
OPENAI_PRIMARY_MODEL=gpt-6-astra
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_FALLBACK_MODELS=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_TIMEOUT_MS=45000
# Total wall-clock budget across provider attempts and retry waits.
OPENAI_TOTAL_TIMEOUT_MS=60000
AI_DAILY_TOKEN_LIMIT=100000
AI_REQUESTS_PER_MINUTE=10
# Set actual approved USD per million token pricing before using estimated cost reporting.
OPENAI_MODEL_PRICING_JSON={}
